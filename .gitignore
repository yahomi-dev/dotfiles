# Mac
.DS_Store

# Vim
*.swp

# packer.nvim
packer_compiled.lua

# Lua
.luarc.json

# Claude
# dotfiles 直下の CLAUDE.md (このリポの作業用) は管理しない。~/.claude に入れる .claude/CLAUDE.md は管理する
/CLAUDE.md
!.claude/
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/rules/
!.claude/commands/
!.claude/agents/
!.claude/hooks/
!.claude/scripts/
!.claude/statusline.mjs
!.claude/statusline-v2.mjs
!.claude/statusline-v2.test.mjs
.claude/settings.local.json

# skills は公開してよいものだけを列挙する
# (社内名を含むもの、出所が外部のもの、claude.ai から同期される synced/ は入れない)
!.claude/skills/
.claude/skills/*
!.claude/skills/aws-arch-diagram/
!.claude/skills/daily-report/
!.claude/skills/decision-coach/
!.claude/skills/erd-no-overlap/
!.claude/skills/explainer-video/
!.claude/skills/ghq-migrate/
!.claude/skills/model-diff-diagram/
# AWS の公式アイコンは再配布しない (scripts/fetch_icons.sh で公式の配布物から取得する)
.claude/skills/aws-arch-diagram/assets/icons/
__pycache__/

# 仕事用のプロファイル (CLAUDE_CONFIG_DIR=~/.claude-work) の実行時に作られるもの
.claude-work/skills/synced/
.claude-work/**/*.log
.claude-work/**/.hook.log
