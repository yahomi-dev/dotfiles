{
  "env": {
    "DAILY_REPORT_DIR": "~/memo/ai-agent",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-work/hooks/backup-transcript.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-work/hooks/deny-origin-write.py --only-under $HOME/review",
            "statusMessage": "origin 書き込みガードを確認中"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline-v2.mjs",
    "padding": 0
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
